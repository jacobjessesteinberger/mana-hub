{
  "name": "mana-hub-starter",
  "version": "0.1.0",
  "private": false,
  "description": "Self-hosted operations dashboard for your own AI agents. Next.js + Supabase + Claude Code, with risk approvals, cron requests, web-push notifications, knowledge base, and a file-drop bridge for tmux-hosted agents.",
  "keywords": [
    "ai-agents",
    "agent-orchestration",
    "claude-code",
    "anthropic",
    "mcp",
    "nextjs",
    "supabase",
    "self-hosted",
    "dashboard",
    "ops"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/jesse-media/mana-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesse-media/mana-hub.git"
  },
  "bugs": {
    "url": "https://github.com/jesse-media/mana-hub/issues"
  },
  "author": {
    "name": "JESSE MEDIA (Jacob Jesse)",
    "url": "https://github.com/jesse-media"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "npx @opennextjs/cloudflare build",
    "deploy": "npm run build:worker && wrangler deploy",
    "preview": "npm run build:worker && wrangler dev",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "doctor": "tsx scripts/doctor.ts",
    "cron:create": "tsx scripts/create-cron-job.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@supabase/supabase-js": "^2.105.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.563.0",
    "next": "^16.2.4",
    "next-themes": "^1.0.0-beta.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.10",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.1",
    "typescript": "^5",
    "wrangler": "^4.92.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
