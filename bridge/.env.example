# ----------------------------------------------------------------------------
# Mana Hub Bridge Environment (template)
# ----------------------------------------------------------------------------
# Copy this file to bridge/.env and fill in real values.
# bridge/.env is gitignored.
# ----------------------------------------------------------------------------

# --- Supabase connection (same project as the dashboard) ---
# Use the SECRET key (sb_secret_...), NOT the publishable key.
# The bridge writes assistant replies and bypasses RLS.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."

# --- Bridge behaviour ---
# Comma-separated list of agent names this bridge process is responsible for.
# Tutorial default: only the main orchestrator agent.
# Valid hardcoded names in src/lib/agents-meta.ts:
#   orchestrator, researcher, creator, operator, builder
BRIDGE_AGENT_NAMES="orchestrator"

# How often the bridge polls Supabase for new user messages (ms).
# Realtime is the primary path; polling is a safety net.
BRIDGE_POLL_INTERVAL_MS="3000"

# How often the bridge writes a heartbeat row per agent (ms).
BRIDGE_HEARTBEAT_INTERVAL_MS="30000"

# Echo-Boilerplate prefix. Replace handleUserMessage() in src/handler.ts
# with a real LLM call to remove this prefix entirely.
BRIDGE_ECHO_PREFIX="[echo-bridge] "

# --- Bridge mode ---
# inline:    Bridge runs the LLM call itself in handler.ts (default for fresh installs).
# file_drop: Bridge writes msg-*.md to <BRIDGE_AGENTS_DIR>/<agent>/inbox/, watches
#            outbox/ for reply-*.md, syncs back to agent_messages. Used when each
#            agent is a Claude Code session in tmux. This is the course mode from
#            Module 3 onwards.
BRIDGE_MODE="inline"

# Base directory containing one folder per file_drop agent (e.g. ~/agents/taro/).
# Only used when BRIDGE_MODE=file_drop. Supports ~ and $HOME expansion.
BRIDGE_AGENTS_DIR="$HOME/agents"

# When true (and BRIDGE_MODE=file_drop), Bridge sends a tmux notification to the
# agent's session whenever a new inbox file arrives. tmux session name must equal
# the agent name. Set false to skip and rely on polling inside the agent's CLAUDE.md.
BRIDGE_TMUX_ENABLED="true"

# How often the Bridge checks agent_cron_jobs for triggers (ms). 300000 = 5 minutes.
BRIDGE_CRON_TICK_INTERVAL_MS="300000"

# --- Web-Push trigger (optional) ---
# When the Bridge inserts a new approval or cron-request via service-role
# (bypassing /api/agents/*), it can ping the dashboard's internal push endpoint
# so the user still gets a browser notification. Both vars must be set on both
# sides; the same token is also in .env.local of the dashboard.
# URL must be reachable from wherever the Bridge runs (usually http://localhost:3000).
MANA_HUB_PUSH_NOTIFY_URL="http://localhost:3000/api/push/notify-internal"
MANA_HUB_INTERNAL_PUSH_TOKEN=""
