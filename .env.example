# ============================================================================
# Mana Hub Starter — Environment template
# ============================================================================
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
#
# Supabase API keys: paste the values from Supabase Dashboard → Project Settings → API.
# Mapping:
#   sb_publishable_...  → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   sb_secret_...       → SUPABASE_SERVICE_ROLE_KEY  (server-side only, bypasses RLS)
# Use only the BASE Supabase URL (e.g. https://abc.supabase.co) — no /rest/v1/ suffix.
# ============================================================================

# --- Supabase (required for non-demo) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
# Optional server-only fallback used by some scripts (scripts/create-cron-job.ts)
SUPABASE_URL=""

# --- Anthropic (optional, used by AI planning assistant in /api/agents/plan) ---
ANTHROPIC_API_KEY=""

# --- Knowledge Base ---
# Folder for the dashboard to index live (.md files only). Absolute path or ~/...
# Leave empty to fall back to bundled demo data.
MANA_HUB_KNOWLEDGE_ROOT=""

# --- Local agent connector (used by demo/local runner only) ---
AGENT_WORKSPACE_DIR=""
AGENT_CONNECTOR_MODE="demo"

# --- Backend / runner adapters ---
MANA_HUB_BACKEND="supabase"
MANA_HUB_RUNNER="demo"
MANA_HUB_TMUX_BIN="tmux"
# Some local runner routes also read TMUX_BIN directly. Point both to the same binary.
TMUX_BIN="tmux"

# --- Optional: pin company context shown to the AI planner ---
# Free text injected into /api/agents/plan prompts.
MANA_HUB_COMPANY_CONTEXT=""

# --- Auth ---
# Admin email used for protected approval/cron endpoints. Must match your login.
ADMIN_EMAIL="you@example.com"
# Optional Google OAuth provider in your Supabase project. Keep "false" if you only
# enable email/magic link.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED="false"

# --- App URL ---
# Must match the port Next.js actually runs on. Default 3000; if 3000 is busy and
# `next dev` falls back to 3001, update this value or your auth callbacks break.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Web Push notifications (optional) ---
# Browser/OS-level notifications when an agent requests an approval or proposes
# a cron job. Generate a VAPID keypair once with:
#   npx web-push generate-vapid-keys
# Then drop the values here. Without these the dashboard still works, the
# "Web-Push Notifications" card just shows "not configured".
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# --- Bridge → Dashboard internal push trigger ---
# The Bridge inserts approvals/cron-requests through the service-role Supabase
# client and bypasses /api/agents/* (where the dashboard's own push hook lives).
# To still get push notifications for agent-driven approvals/cron-requests, set
# both vars (the same MANA_HUB_INTERNAL_PUSH_TOKEN must also be set in the
# Bridge's environment, see bridge/.env.example).
MANA_HUB_INTERNAL_PUSH_TOKEN=""

# --- Demo mode ---
# Local preview mode: lets users open the dashboard without Supabase OAuth.
# Set both to "false" for production.
NEXT_PUBLIC_MANA_HUB_DEMO_MODE="true"
MANA_HUB_DEMO_MODE="true"
