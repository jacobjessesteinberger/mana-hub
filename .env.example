NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Optional AI planning assistant
ANTHROPIC_API_KEY=""

# Optional local agent connector
AGENT_WORKSPACE_DIR=""
AGENT_CONNECTOR_MODE="demo"
MANA_HUB_BACKEND="supabase"
MANA_HUB_RUNNER="demo"
MANA_HUB_TMUX_BIN="tmux"

# Optional admin email for protected approval actions
ADMIN_EMAIL="you@example.com"

# App URL used by auth callbacks and deployments
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local preview mode: lets users open the dashboard without Supabase OAuth.
# Set both values to "false" for production.
NEXT_PUBLIC_MANA_HUB_DEMO_MODE="true"
MANA_HUB_DEMO_MODE="true"
