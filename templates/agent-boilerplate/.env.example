# Per-agent secrets. Copy this file to .env in the same folder, fill in real
# values, and never commit it. Loaded by start.sh and by Claude Code when it
# launches inside this folder.

# --- MCP server keys (only set the ones you actually wire in .mcp.json) ---
PERPLEXITY_API_KEY=""
YOUTUBE_API_KEY=""
SLACK_BOT_TOKEN=""
SLACK_TEAM_ID=""

# --- Optional: explicit Anthropic settings if not inherited from your shell ---
# ANTHROPIC_API_KEY=""

# --- Anything else this agent needs at runtime ---
# Example: Notion, GitHub, Stripe, Linear, etc.
